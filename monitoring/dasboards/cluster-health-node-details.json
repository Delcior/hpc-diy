{
  "id": null,
  "uid": "cluster-health-node-details",
  "title": "Cluster Health - Node Details",
  "tags": ["cluster", "node-exporter"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "custom",
        "query": "major-tom,bowie,ground-control",
        "options": [
          {"selected": true, "text": "major-tom", "value": "major-tom"},
          {"selected": false, "text": "bowie", "value": "bowie"},
          {"selected": false, "text": "ground-control", "value": "ground-control"}
        ],
        "includeAll": false,
        "multi": false,
        "current": {"text": "major-tom", "value": "major-tom"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU",
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["last", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [{"expr": "100 * (1 - avg by (instance, node) (rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\",node=~\"$node\"}[1m])))", "legendFormat": "{{node}}", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["last", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node-exporter\",node=~\"$node\"} / node_memory_MemTotal_bytes{job=\"node-exporter\",node=~\"$node\"})", "legendFormat": "{{node}}", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU usage by core",
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 10},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["last", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [{"expr": "100 * (1 - rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\",node=~\"$node\"}[1m]))", "legendFormat": "{{node}} CPU {{cpu}}", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Network throughput",
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 10},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "bps", "min": 0}, "overrides": []},
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["last", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"expr": "rate(node_network_receive_bytes_total{job=\"node-exporter\",device!=\"lo\",node=~\"$node\"}[5m]) * 8", "legendFormat": "{{node}} {{device}} RX", "refId": "A"},
        {"expr": "rate(node_network_transmit_bytes_total{job=\"node-exporter\",device!=\"lo\",node=~\"$node\"}[5m]) * 8", "legendFormat": "{{node}} {{device}} TX", "refId": "B"}
      ]
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "CPU Temperature",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "celsius", "decimals": 1, "min": 0, "max": 100}, "overrides": []},
      "options": {"orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true, "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "node_thermal_zone_temp{job=\"node-exporter\",type=~\"CPU-therm|cpu-thermal\",node=~\"$node\"}", "legendFormat": "{{node}} CPU", "refId": "A", "instant": true}]
    },
    {
      "id": 6,
      "type": "gauge",
      "title": "GPU Temperature",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "celsius", "decimals": 1, "min": 0, "max": 100}, "overrides": []},
      "options": {"orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true, "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "node_thermal_zone_temp{job=\"node-exporter\",type=\"GPU-therm\",node=~\"$node\"}", "legendFormat": "{{node}} GPU", "refId": "A", "instant": true}]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GPU Usage",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 28},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["last", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "max by (node) (jetson_gpu_utilization_percent{job=\"node-exporter\",node=~\"$node\"})", "legendFormat": "{{node}}", "refId": "A"}]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Power Consumption",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 36},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "watt", "decimals": 2, "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["last", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "jetson_power_watts{job=\"node-exporter\",rail=\"POM_5V_IN\",node=~\"$node\"}", "legendFormat": "Total", "refId": "A"},
        {"expr": "jetson_power_watts{job=\"node-exporter\",rail=\"POM_5V_GPU\",node=~\"$node\"}", "legendFormat": "GPU", "refId": "B"},
        {"expr": "jetson_power_watts{job=\"node-exporter\",rail=\"POM_5V_CPU\",node=~\"$node\"}", "legendFormat": "CPU", "refId": "C"}
      ]
    }
  ]
}
