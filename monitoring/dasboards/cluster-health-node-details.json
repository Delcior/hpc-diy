{
  "id": null,
  "uid": "cluster-health-node-details",
  "title": "Cluster Health - Node Details",
  "tags": ["cluster", "node-exporter"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "custom",
        "query": "major-tom,ground-control",
        "options": [
          {"selected": true, "text": "major-tom", "value": "major-tom"},
          {"selected": false, "text": "ground-control", "value": "ground-control"}
        ],
        "includeAll": false,
        "multi": false,
        "current": {"text": "major-tom", "value": "major-tom"}
      },
      {
        "name": "cpu_count",
        "label": "CPU count",
        "type": "query",
        "hide": 2,
        "datasource": {"type": "prometheus", "uid": "Prometheus"},
        "definition": "query_result(count by (node) (node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\",node=\"$node\"}))",
        "query": {"query": "query_result(count by (node) (node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\",node=\"$node\"}))", "refId": "StandardVariableQuery"},
        "regex": "/\\}\\s+([0-9.]+)/",
        "refresh": 2,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 17,
      "type": "timeseries",
      "title": "All Jobs States",
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["last", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "slurm_jobs_running{job=\"slurm\"}", "legendFormat": "Running", "refId": "A"},
        {"expr": "slurm_jobs_pending{job=\"slurm\"}", "legendFormat": "Pending", "refId": "B"},
        {"expr": "slurm_jobs_completing{job=\"slurm\"}", "legendFormat": "Completing", "refId": "C"},
        {"expr": "slurm_jobs_failed{job=\"slurm\"}", "legendFormat": "Failed", "refId": "D"},
        {"expr": "slurm_jobs_suspended{job=\"slurm\"}", "legendFormat": "Suspended", "refId": "E"}
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "CPU Load - $cpu_count CPUs",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["last", "max"]}, "tooltip": {"mode": "single"}},
      "targets": [{"expr": "node_load1{job=\"node-exporter\",node=~\"$node\"}", "legendFormat": "Load average", "refId": "A"}]
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage",
      "gridPos": {"h": 10, "w": 8, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Overall usage"}, "properties": [{"id": "color", "value": {"fixedColor": "purple", "mode": "fixed"}}]}
        ]
      },
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["last", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "100 * (1 - avg by (instance, node) (rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\",node=~\"$node\"}[1m])))", "legendFormat": "Overall usage", "refId": "A"},
        {"expr": "100 * (1 - rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\",node=~\"$node\"}[1m]))", "legendFormat": "CPU {{cpu}}", "refId": "B"}
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "GPU Usage",
      "gridPos": {"h": 10, "w": 8, "x": 8, "y": 8},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["last", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "max by (node) (jetson_gpu_utilization_percent{job=\"node-exporter\",node=~\"$node\"})", "legendFormat": "{{node}}", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory usage",
      "gridPos": {"h": 10, "w": 8, "x": 16, "y": 8},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["last", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node-exporter\",node=~\"$node\"} / node_memory_MemTotal_bytes{job=\"node-exporter\",node=~\"$node\"})", "legendFormat": "{{node}}", "refId": "A"}]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "CPU Temperature",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 18},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "celsius", "decimals": 1}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["last", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "node_thermal_zone_temp{job=\"node-exporter\",type=~\"CPU-therm|cpu-thermal\",node=~\"$node\"}", "legendFormat": "{{node}}", "refId": "A"}]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "GPU Temperature",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 18},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "celsius", "decimals": 1}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["last", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "node_thermal_zone_temp{job=\"node-exporter\",type=\"GPU-therm\",node=~\"$node\"}", "legendFormat": "{{node}}", "refId": "A"}]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Power Consumption",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 18},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "watt", "decimals": 2, "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["last", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "jetson_power_watts{job=\"node-exporter\",rail=\"POM_5V_IN\",node=~\"$node\"}", "legendFormat": "Total", "refId": "A"},
        {"expr": "jetson_power_watts{job=\"node-exporter\",rail=\"POM_5V_GPU\",node=~\"$node\"}", "legendFormat": "GPU", "refId": "B"},
        {"expr": "jetson_power_watts{job=\"node-exporter\",rail=\"POM_5V_CPU\",node=~\"$node\"}", "legendFormat": "CPU", "refId": "C"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Network throughput",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "bps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["last", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "rate(node_network_receive_bytes_total{job=\"node-exporter\",device!=\"lo\",node=~\"$node\"}[5m]) * 8", "legendFormat": "{{node}} {{device}} RX", "refId": "A"},
        {"expr": "rate(node_network_transmit_bytes_total{job=\"node-exporter\",device!=\"lo\",node=~\"$node\"}[5m]) * 8", "legendFormat": "{{node}} {{device}} TX", "refId": "B"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "NFS RPC and request rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 26},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["last", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "rate(node_nfs_rpcs_total{job=\"node-exporter\",node=~\"$node\"}[5m])", "legendFormat": "{{node}} RPCs", "refId": "A"},
        {"expr": "rate(node_nfs_requests_total{job=\"node-exporter\",node=~\"$node\"}[5m])", "legendFormat": "{{node}} {{proto}} {{method}}", "refId": "B"},
        {"expr": "rate(node_nfs_rpc_retransmissions_total{job=\"node-exporter\",node=~\"$node\"}[5m])", "legendFormat": "{{node}} retransmits", "refId": "C"}
      ]
    }
  ]
}
