{
  "id": null,
  "uid": "cluster-health-overview",
  "title": "Cluster Health Overview",
  "tags": ["cluster", "node-exporter", "nfs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "targets": [{"expr": "100 * (1 - avg by (instance, node) (rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}[5m])))", "legendFormat": "{{node}}", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory usage",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node-exporter\",node!=\"monitoring-host\"} / node_memory_MemTotal_bytes{job=\"node-exporter\",node!=\"monitoring-host\"})", "legendFormat": "{{node}}", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Network throughput",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "bps"}, "overrides": []},
      "targets": [
        {"expr": "(rate(node_network_receive_bytes_total{job=\"node-exporter\",node=~\"major-tom|ground-control\",device=\"eth0\"}[5m]) or rate(node_network_receive_bytes_total{job=\"node-exporter\",node=\"bowie\",device=~\"eth0|enx.*\"}[5m])) * 8", "legendFormat": "{{node}} {{device}} RX", "refId": "A"},
        {"expr": "(rate(node_network_transmit_bytes_total{job=\"node-exporter\",node=~\"major-tom|ground-control\",device=\"eth0\"}[5m]) or rate(node_network_transmit_bytes_total{job=\"node-exporter\",node=\"bowie\",device=~\"eth0|enx.*\"}[5m])) * 8", "legendFormat": "{{node}} {{device}} TX", "refId": "B"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "NFS RPC and request rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [
        {"expr": "rate(node_nfs_rpcs_total{job=\"node-exporter\"}[5m])", "legendFormat": "{{node}} RPCs", "refId": "A"},
        {"expr": "rate(node_nfs_requests_total{job=\"node-exporter\"}[5m])", "legendFormat": "{{node}} {{proto}} {{method}}", "refId": "B"},
        {"expr": "rate(node_nfs_rpc_retransmissions_total{job=\"node-exporter\"}[5m])", "legendFormat": "{{node}} retransmits", "refId": "C"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "/mnt/cluster-workspace usage",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node-exporter\",mountpoint=\"/mnt/cluster-workspace\"} / node_filesystem_size_bytes{job=\"node-exporter\",mountpoint=\"/mnt/cluster-workspace\"})", "legendFormat": "{{node}} {{device}}", "refId": "A"}]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Workspace filesystem capacity",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [
        {"expr": "node_filesystem_size_bytes{job=\"node-exporter\",mountpoint=\"/mnt/cluster-workspace\"}", "legendFormat": "{{node}} total", "refId": "A"},
        {"expr": "node_filesystem_avail_bytes{job=\"node-exporter\",mountpoint=\"/mnt/cluster-workspace\"}", "legendFormat": "{{node}} available", "refId": "B"}
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "CPU Temperature",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "fieldConfig": {"defaults": {"unit": "celsius", "decimals": 1}, "overrides": []},
      "options": {"showHeader": true, "cellHeight": "sm"},
      "targets": [{"expr": "node_thermal_zone_temp{job=\"node-exporter\",type=\"CPU-therm\"}", "legendFormat": "{{node}}", "refId": "A", "instant": true, "format": "table"}]
    },
    {
      "id": 13,
      "type": "table",
      "title": "GPU Temperature",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "fieldConfig": {"defaults": {"unit": "celsius", "decimals": 1}, "overrides": []},
      "options": {"showHeader": true, "cellHeight": "sm"},
      "targets": [{"expr": "node_thermal_zone_temp{job=\"node-exporter\",type=\"GPU-therm\"}", "legendFormat": "{{node}}", "refId": "A", "instant": true, "format": "table"}]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Load per CPU",
      "description": "Values above 1 indicate more load than one logical CPU can handle.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "targets": [{"expr": "node_load1{job=\"node-exporter\"} / count by (instance, node) (node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"})", "legendFormat": "{{node}}", "refId": "A"}]
    }
  ]
}
